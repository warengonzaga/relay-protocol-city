# Keep this server-side. Never prefix a secret with VITE_.
RELAY_API_KEY=

# Integrator is the conservative default. Set global only after Relay confirms
# that the configured key is approved for network-wide activity.
RELAY_NETWORK_SCOPE=integrator

# Optional anonymous development preview only. v2 retires November 24, 2026.
# A key always takes precedence. Without either, the city runs in labeled demo mode.
RELAY_ALLOW_LEGACY_PREVIEW=false

# Local development serves the API behind Vite's same-origin proxy.
HOST=127.0.0.1
PORT=4174

# Railway's Dockerfile supplies API_ONLY=true and HOST=0.0.0.0.
# Leave these unset locally; Railway supplies PORT automatically.
# API_ONLY=true
# ALLOWED_ORIGINS=https://waren.build

# Public full activity endpoint for a split frontend build; this is NOT a secret.
# Set it as a GitHub Actions repository Variable after deploying the Railway API.
# An unset URL in Pages mode gives a labeled demo without API polling.
# VITE_API_URL=https://your-service.up.railway.app/api/activity
